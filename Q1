public class Q1 {
    public static void main(String[] args) {
        for (int i = 1; i <= 20; i++) {
            System.out.print(getTriangular(i) + " ");
        }
    }

    public static int getTriangular(int n) {
        int sum = 0;
        for (int i = 1; i <= n; i++) {
            sum += i;
        }
        return sum;
    }
}
