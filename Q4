public class Q4 {
    public static void main(String[] args) {
        System.out.println("GCD of (24, 8): " + getGCD(24, 8));
        System.out.println("GCD of (200, 625): " + getGCD(200, 625));
    }

    public static int getGCD(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
}
