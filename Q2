public class Q2 {
    public static void main(String[] args) {
        // Print triangle
        for (int i = 1; i <= 5; i++) {
            multiPrint(5 - i, ' ');
            multiPrint(2 * i - 1, '*');
            System.out.println();
        }

        System.out.println();

        // Print diamond
        for (int i = 1; i <= 5; i++) {
            multiPrint(5 - i, ' ');
            multiPrint(2 * i - 1, '*');
            System.out.println();
        }
        for (int i = 4; i >= 1; i--) {
            multiPrint(5 - i, ' ');
            multiPrint(2 * i - 1, '*');
            System.out.println();
        }
    }

    public static void multiPrint(int n, char c) {
        for (int i = 0; i < n; i++) {
            System.out.print(c);
        }
    }
}
